{
  "name": "critique-workspace",
  "private": true,
  "workspaces": ["./*", "packages/*"],
  "scripts": {
    "build:agentation": "bun run --cwd packages/agentation build",
    "test:agentation": "bun run --cwd packages/agentation test",
    "build:comments-widget": "bun run build:agentation && bun run cli/scripts/build-widget.ts",
    "build:comments-server": "bun run --filter '@critique.work/server' build"
  }
}
